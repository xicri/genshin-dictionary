{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "checkJs": false, // This causes unnecessary type checks for .svelte-kit/**/*.js
    "sourceMap": true,
    "strict": true,
    "types": [
      "$app/types",
      "./worker-configuration.d.ts"
    ]
  },
  "include": [
    "src",
    "**/*.ts"
  ]
}
